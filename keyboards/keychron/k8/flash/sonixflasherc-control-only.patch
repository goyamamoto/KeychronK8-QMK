libusb: fall back to control transfers when the HID driver can't be detached

macOS refuses detach/claim of a keyboard's HID interface for unprivileged
processes, but feature reports go over endpoint 0 and need neither.

Applies to SonixFlasherC 3.0.0 (73f9fab8a82c5c4f91181d276676c8f936726925).
---
diff --git a/src/usb_device_libusb.c b/src/usb_device_libusb.c
index 173cf02..e41bb56 100644
--- a/src/usb_device_libusb.c
+++ b/src/usb_device_libusb.c
@@ -1,4 +1,5 @@
 #include "config.h"
+#include "log.h"
 #include "mem.h"
 #include "usb_device.h"
 
@@ -182,9 +183,14 @@ usb_device_t *usb_device_open(uint16_t vid, uint16_t pid) {
     result = libusb_detach_kernel_driver(dev->handle, HID_INTERFACE_NUMBER);
 
     if (result < 0) {
-      set_error(dev, "failed to detach kernel driver", result);
-      usb_device_close(dev);
-      return NULL;
+      /*
+       * macOS will not let an unprivileged process detach its HID driver.
+       * HID feature reports travel over endpoint 0, which needs neither the
+       * detach nor the claim, so carry on with control transfers only.
+       */
+      log_warn("Cannot detach kernel driver (%s), using control transfers only",
+               libusb_error_name(result));
+      return dev;
     }
 
     dev->kernel_driver_detached = true;
@@ -196,9 +202,9 @@ usb_device_t *usb_device_open(uint16_t vid, uint16_t pid) {
 
   result = libusb_claim_interface(dev->handle, HID_INTERFACE_NUMBER);
   if (result < 0) {
-    set_error(dev, "failed to claim HID interface", result);
-    usb_device_close(dev);
-    return NULL;
+    log_warn("Cannot claim HID interface (%s), using control transfers only",
+             libusb_error_name(result));
+    return dev;
   }
 
   dev->interface_claimed = true;
