// Keychron K8 (SN32F248B) for Renode: CPU, memories and the peripheral
// models in sn32.cs and iton.cs. Pins follow keyboards/keychron/k8/rgb.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 48000000
    -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x0
    size: 0x10000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000

ct16b0: K8.SN32Timer @ sysbus 0x40000000
    IRQ -> nvic@15

ct16b1: K8.SN32Timer @ sysbus 0x40002000
    IRQ -> nvic@16

wdt: K8.SN32RegFile @ sysbus 0x40010000

spi0: K8.SN32Spi @ sysbus 0x4001C000
    IRQ -> nvic@6

adc: K8.SN32RegFile @ sysbus 0x40026000

pmu: K8.SN32Pmu @ sysbus 0x40032000

pfpa: K8.SN32RegFile @ sysbus 0x40042000

gpio: K8.SN32Gpio @ sysbus 0x40044000
    rowPins: "C15,D11,D10,D9,D8,D7"
    colPins: "A8,A9,A10,A11,A12,A13,A14,A15,B0,B1,B2,B3,B4,B5,B6,B7,B8"
    IRQA -> nvic@31
    IRQB -> nvic@30
    IRQC -> nvic@29
    IRQD -> nvic@28

usb: K8.SN32Usb @ sysbus 0x4005C000
    IRQ -> nvic@1

sys1: K8.SN32RegFile @ sysbus 0x4005E000

sys0: K8.SN32Sys0 @ sysbus 0x40060000

flashctrl: K8.SN32Flash @ sysbus 0x40062000

iton: K8.ItonModule @ sysbus 0x5FFF0000
    gpio: gpio
    spi: spi0
    pmu: pmu
